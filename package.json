{
  "name": "dsh-persona-memory",
  "version": "0.2.2",
  "description": "Daily cross-workspace session digest that grows a user profile and a companion personality, then injects both into every prompt.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PaangGaaSam/dsh-persona-memory.git"
  },
  "homepage": "https://github.com/PaangGaaSam/dsh-persona-memory#readme",
  "bugs": {
    "url": "https://github.com/PaangGaaSam/dsh-persona-memory/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "memory",
    "persona",
    "profile"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "license": "MIT"
}
